  "description": "",
  "private": true,
  "dependencies": {
    "@midwayjs/bootstrap": "^4.0.0",
    "@midwayjs/core": "^4.0.0",
    "@midwayjs/cross-domain": "^4.2.1",
    "@midwayjs/info": "^4.0.0",
    "@midwayjs/jwt": "^4.2.1",
    "@midwayjs/koa": "^4.0.0",
    "@midwayjs/logger": "^4.0.0",
    "@midwayjs/redis": "^4.2.1",
    "@midwayjs/skill-midway": "^4.2.1",
    "@midwayjs/socketio": "^4.2.1",
    "@midwayjs/swagger": "^4.2.1",
    "@midwayjs/typeorm": "^4.2.1",
    "@midwayjs/validation": "^4.0.0",
    "@midwayjs/validation-joi": "^4.0.0",
    "algochat-ai": "^1.0.0",
    "axios": "^1.19.0",
    "joi": "^17.13.3",
    "pg": "^8.23.0",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@midwayjs/mock": "^4.0.0",
    "@types/jest": "^29.2.0",
    "@types/node": "20",
    "@types/socket.io-client": "^1.4.36",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mwts": "^2.0.4",
    "mwtsc": "^1.4.0",
    "socket.io-client": "^4.8.1",
    "swagger-ui-dist": "^5.32.13",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=dev node ./bootstrap.js",
    "dev": "cross-env NODE_ENV=local mwtsc --watch --run @midwayjs/mock/app.js",
    "test": "cross-env NODE_ENV=unittest jest --runInBand",
    "cov": "jest --coverage",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build": "mwtsc --cleanOutDir",
    "entity:create": "npx mwtypeorm entity:create",
    "migration:generate": "npx mwtypeorm migration:generate -d",
    "migration:create": "npx mwtypeorm migration:create",
    "migration:run": "npx mwtypeorm migration:run -d",
    "migration:run-default": "npx mwtypeorm migration:run -d ./src/config/config.default.ts"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
